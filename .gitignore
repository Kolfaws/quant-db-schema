# =====================================
# 1. 敏感信息与环境变量
# =====================================
.env
.env.*
!.env.example
*.pem
*.key

# =====================================
# 2. 数据文件 (量化项目常见)
# =====================================
# 忽略 data 下的所有文件，但保留目录结构和 .gitkeep
data/**
!data/.gitkeep
!data/raw/
!data/processed/
!data/**/.gitkeep

# 常见数据文件格式
*.parquet
*.csv
*.xlsx
*.db
*.duckdb
*.sqlite
*.sqlite3
*.h5
*.hdf5
*.pkl
*.feather
*.arrow

# =====================================
# 3. Python 运行缓存与构建产物
# =====================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# =====================================
# 4. 虚拟环境
# =====================================
.venv/
venv/
env/
ENV/

# =====================================
# 5. 日志文件
# =====================================
*.log
logs/**
!logs/.gitkeep

# =====================================
# 6. 测试与类型检查缓存
# =====================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# =====================================
# 7. 操作系统与编辑器文件
# =====================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# =====================================
# 8. Jupyter Notebook 检查点
# =====================================
.ipynb_checkpoints/
