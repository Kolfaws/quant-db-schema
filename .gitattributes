# =============================================================================
# .gitattributes — 换行符与二进制文件规则
#
# 原则：文本统一 LF（避免 Windows 下 CRLF 造成的全文件 diff），
#       二进制交给 Git 直通，Windows 脚本保留 CRLF。
# =============================================================================

# 1. 默认：自动识别文本文件，提交时统一转 LF
* text=auto eol=lf

# 2. 显式声明文本文件（在 Windows 上也能保证 LF）
*.py        text eol=lf
*.pyi       text eol=lf
*.md        text eol=lf
*.markdown  text eol=lf
*.txt       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.sh        text eol=lf
*.sql       text eol=lf
*.tex       text eol=lf
*.bib       text eol=lf

# 3. Windows 专用脚本保持 CRLF（否则 cmd.exe / PowerShell 可能异常）
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 4. 二进制：禁止 Git 做 diff 或换行符转换
*.db          binary
*.db-journal  binary
*.db-wal      binary
*.db-shm      binary
*.sqlite      binary
*.sqlite3     binary
*.duckdb      binary
*.duckdb.wal  binary
*.parquet     binary
*.feather     binary
*.arrow       binary
*.pkl         binary
*.h5          binary
*.hdf5        binary
*.npz         binary
*.zip         binary
*.gz          binary
*.tar         binary
*.pdf         binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.xls         binary
*.xlsx        binary
*.docx        binary
*.pptx        binary

# SVG 是文本，保持 LF
*.svg         text eol=lf

# 5. Jupyter Notebook（配合 pre-commit 的 nbstripout 清空输出）
*.ipynb     text eol=lf